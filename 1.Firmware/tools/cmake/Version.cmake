execute_process(
  COMMAND git describe --tags --abbrev=0
  WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
  OUTPUT_VARIABLE GDS_GIT_TAG
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
  RESULT_VARIABLE GIT_DESCRIBE_RESULT)

if(NOT GIT_DESCRIBE_RESULT EQUAL 0 OR GDS_GIT_TAG STREQUAL "")
  set(GDS_GIT_TAG "v0.0.0")
endif()

string(REGEX REPLACE "^v|-.*$" "" GDS_VERSION "${GDS_GIT_TAG}")
string(REGEX REPLACE "^v" "" GIT_VERSION "${GDS_GIT_TAG}")
