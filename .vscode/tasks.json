{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake -B build -G Ninja",
      "options": {
        "cwd": "${workspaceFolder}/1.Firmware"
      },
      "detail": "配置",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "ninja -C build",
      "options": {
        "cwd": "${workspaceFolder}/1.Firmware"
      },
      "detail": "编译",
      "problemMatcher": []
    },
    {
      "label": "configure + build",
      "dependsOn": [
        "configure",
        "build"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "flash: jlink",
      "type": "shell",
      "command": "python tools/script/devtool.py flash jlink",
      "options": {
        "cwd": "${workspaceFolder}/1.Firmware"
      },
      "detail": "烧录 (J-Link / SEGGER) 并复位运行",
      "presentation": {
        "group": "flash",
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    },
    {
